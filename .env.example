# Local LLM (free, runs on your machine or in the ollama container)
VOUCH_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# Storage (SQLite; users, expert requests, gap log)
VOUCH_DB_PATH=data/vouch.db

# Accounts
VOUCH_ALLOW_REGISTRATION=true       # self-registration creates consultants; admins grant expert/admin roles
VOUCH_SESSION_IDLE_MINUTES=60

# Demo only: shows demo account names on the login page and the admin "Reset demo" button
VOUCH_DEMO_MODE=false
# Password for `python -m vouch.accounts seed-demo` (12+ chars). Never commit a real value.
VOUCH_DEMO_PASSWORD=
