# Copy to .env and fill in. Never commit .env.

# --- Claude (OPTIONAL, paid; leave empty for the zero-cost build: keyword rules + manual claims) ---
ANTHROPIC_API_KEY=
# Must be a model id your key can use; `npm run check:llm` validates it with a tiny real request.
ANTHROPIC_MODEL=claude-opus-5

# --- Email via Resend (OPTIONAL; leave empty: expert requests then use in-app notifications only) ---
RESEND_API_KEY=
# Without a verified domain, Resend only allows onboarding@resend.dev -> the Resend account owner's address.
EMAIL_FROM=Vouch demo <onboarding@resend.dev>
# The ONLY recipient Vouch will email: the team-provided demo expert inbox.
DEMO_EXPERT_EMAIL=

# --- Demo accounts (seeded by `npm run db:seed`) ---
DEMO_CONSULTANT_PASSWORD=
DEMO_EXPERT_PASSWORD=
# Second expert (Netherlands) used to prove an unassigned expert cannot resolve Belgian cases.
DEMO_NL_EXPERT_PASSWORD=

# --- Server ---
PORT=8787
# Public origin of the app; used for the "Open review" link and the Origin/CSRF check.
APP_BASE_URL=http://localhost:8787
# SQLite file on persistent local disk.
DATABASE_PATH=./data/vouch.sqlite
